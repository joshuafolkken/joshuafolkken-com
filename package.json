{
	"name": "joshuafolkken-com",
	"private": true,
	"version": "0.182.0",
	"type": "module",
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"engines": {
		"node": ">=22.19.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"onFail": "error"
		}
	},
	"pnpm": {
		"overrides": {
			"undici": ">=7.24.0",
			"esbuild@<=0.24.2": ">=0.25.0",
			"cookie@<0.7.0": ">=0.7.0",
			"drizzle-orm@<0.45.2": ">=0.45.2",
			"@sveltejs/kit@<=2.57.0": ">=2.57.1"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		],
		"ignoredBuiltDependencies": [
			"lefthook"
		]
	},
	"scripts": {
		"preinstall": "pnpm dlx @aikidosec/safe-chain setup-ci",
		"postinstall": "lefthook install",
		"dev": "vite dev",
		"dev:cloudflare": "pnpm build && wrangler dev --remote",
		"build": "vite build",
		"build:preview": "pnpm build && pnpm preview",
		"deploy": "pnpm build && wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"preview:normal": "vite preview",
		"preview:stop": "kill-port 4173 || true",
		"prepare": "pnpm gen && svelte-kit sync",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "pnpm gen:pre && wrangler types",
		"gen:pre": "rm -f .svelte-kit/cloudflare/_worker.*",
		"start:pm2": "pm2 restart joshuafolkken-com || pm2 start ecosystem.config.cjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "export LOCAL_DB_PATH=$(find .wrangler/state/v3/d1 -name '*.sqlite' -type f 2>/dev/null | head -1) && drizzle-kit studio",
		"check:upstream": "tsx scripts/check-upstream-drift.ts",
		"size-limit": "size-limit",
		"josh": "josh"
	},
	"size-limit": [
		{
			"path": ".svelte-kit/output/client/_app/immutable/**/*.js",
			"limit": "500 kB"
		}
	],
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@joshuafolkken/kit": "0.55.0",
		"@playwright/test": "^1.59.1",
		"@prgm/sveltekit-progress-bar": "^3.0.2",
		"@size-limit/file": "^12.1.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.6.0",
		"@vitest/browser-playwright": "^4.1.4",
		"better-sqlite3": "^12.9.0",
		"cspell": "^10.0.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-sonarjs": "^4.0.3",
		"eslint-plugin-svelte": "^3.17.0",
		"eslint-plugin-unicorn": "^64.0.0",
		"globals": "^17.5.0",
		"kill-port": "^2.0.1",
		"lefthook": "2.1.6",
		"mdsvex": "^0.12.7",
		"neverthrow": "^8.2.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"rollup-plugin-visualizer": "^7.0.1",
		"size-limit": "^12.1.0",
		"svelte": "^5.55.4",
		"svelte-check": "^4.4.6",
		"svelte-fast-check": "^0.4.5",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.2",
		"vite": "^8.0.9",
		"vite-imagetools": "^10.0.0",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.4",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.83.0"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"sharp": "^0.34.5",
		"simple-icons": "^16.17.0",
		"zod": "^4.3.6"
	}
}
