{
	"name": "joshuafolkken-com",
	"private": true,
	"version": "0.70.0",
	"type": "module",
	"packageManager": "pnpm@10.24.0",
	"scripts": {
		"preinstall": "npx only-allow pnpm && pnpm dlx @aikidosec/safe-chain setup-ci",
		"postinstall": "lefthook install",
		"setup:security": "safe-chain setup",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:stop": "pnpm exec kill-port 4173 || true",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "svelte-kit sync && prettier --check . && eslint . --cache",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"lefthook:install": "lefthook install",
		"lefthook:uninstall": "lefthook uninstall",
		"lefthook:commit": "lefthook run pre-commit",
		"lefthook:push": "lefthook run pre-push",
		"check-commit-message": "tsx scripts/check-commit-message.ts",
		"prevent-main-commit": "tsx scripts/prevent-main-commit.ts",
		"git": "tsx scripts/git-workflow.ts",
		"start:pm2": "pm2 restart joshuafolkken-com || pm2 start ecosystem.config.cjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"devDependencies": {
		"@aikidosec/safe-chain": "^1.2.2",
		"@eslint/compat": "^2.0.0",
		"@eslint/js": "^9.39.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.0",
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24.10.1",
		"@vitest/browser-playwright": "^4.0.15",
		"cspell": "^9.4.0",
		"drizzle-kit": "^0.31.8",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-sonarjs": "^3.0.5",
		"eslint-plugin-svelte": "^3.13.1",
		"eslint-plugin-unicorn": "^62.0.0",
		"globals": "^16.5.0",
		"kill-port": "^2.0.1",
		"lefthook": "2.0.8",
		"mdsvex": "^0.12.6",
		"playwright": "^1.57.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vitest": "^4.0.15",
		"vitest-browser-svelte": "^2.0.1"
	},
	"dependencies": {
		"@libsql/client": "^0.15.15",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.45.0",
		"sharp": "^0.34.5"
	},
	"pnpm": {
		"overrides": {
			"esbuild": "^0.25.0",
			"cookie": "^0.7.0"
		}
	}
}
