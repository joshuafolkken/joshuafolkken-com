# Copy this file to `.env` (git-ignored) and fill in real values.

# Telegram notifications (scripts-ai / `pnpm josh notify`).
# Bot token from BotFather; chat/user id of the notification target.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Cloudflare Access service token — only needed for `pnpm dev:remote`, which runs
# local dev against remote-only bindings such as AI Search. The *.workers.dev
# domain is behind Cloudflare Access, so wrangler authenticates non-interactively
# with these. Create one in Zero Trust -> Access -> Service Auth -> Service Tokens,
# then allow it on the Access application policy (Action: Service Auth).
CLOUDFLARE_ACCESS_CLIENT_ID=your-access-client-id
CLOUDFLARE_ACCESS_CLIENT_SECRET=your-access-client-secret

# GitHub docs ingestion (`pnpm ingest:github-docs`) — uploads public repo README +
# docs/**.md + prompts/**.md into the AI Search instance's built-in storage.
# ACCOUNT_ID from the Cloudflare dashboard; API_TOKEN is a standard API token with
# AI Search (Read/Edit) permission — NOT the Access service token above.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Optional overrides.
AI_SEARCH_INSTANCE=joshuafolkken-com-chat
GITHUB_DOCS_OWNER=joshuafolkken
# Optional: a fine-grained or classic token raises GitHub API rate limits.
GITHUB_TOKEN=your-github-token
