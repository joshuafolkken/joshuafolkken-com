{
	"name": "joshuafolkken-com",
	"version": "0.242.0",
	"type": "module",
	"private": true,
	"scripts": {
		"preinstall": "pnpm dlx @aikidosec/safe-chain setup-ci",
		"dev": "vite dev",
		"dev:cloudflare": "pnpm build && wrangler dev --remote",
		"build": "vite build",
		"build:preview": "pnpm build && pnpm preview",
		"deploy": "pnpm build && wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"preview:normal": "vite preview",
		"preview:stop": "kill-port 4173 || true",
		"prepare": "pnpm gen && svelte-kit sync && command -v lefthook >/dev/null 2>&1 && lefthook install; command -v tsx >/dev/null 2>&1 && tsx node_modules/@joshuafolkken/kit/scripts/fix-gh-packages.ts; true",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "pnpm gen:pre && wrangler types",
		"gen:pre": "rm -f .svelte-kit/cloudflare/_worker.*",
		"start:pm2": "pm2 restart joshuafolkken-com || pm2 start ecosystem.config.cjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "export LOCAL_DB_PATH=$(find .wrangler/state/v3/d1 -name '*.sqlite' -type f 2>/dev/null | head -1) && drizzle-kit studio",
		"check:upstream": "tsx scripts/check-upstream-drift.ts",
		"size-limit": "size-limit",
		"josh": "josh"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"minisearch": "^7.2.0",
		"sharp": "^0.34.5",
		"simple-icons": "^16.22.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@joshuafolkken/kit": "0.228.0",
		"@playwright/test": "^1.60.0",
		"@prgm/sveltekit-progress-bar": "^3.0.2",
		"@size-limit/file": "^12.1.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^25.9.1",
		"@vitest/browser-playwright": "^4.1.8",
		"better-sqlite3": "^12.10.0",
		"cspell": "^10.0.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-sonarjs": "^4.0.3",
		"eslint-plugin-svelte": "^3.19.0",
		"eslint-plugin-unicorn": "^64.0.0",
		"globals": "^17.6.0",
		"kill-port": "^2.0.1",
		"lefthook": "2.1.9",
		"mdsvex": "^0.12.7",
		"neverthrow": "^8.2.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rollup-plugin-visualizer": "^7.0.1",
		"size-limit": "^12.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.5.0",
		"svelte-fast-check": "^0.4.5",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vite-imagetools": "^10.0.0",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "4.97.0"
	},
	"packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
	"engines": {
		"node": ">=22.19.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.5.0",
			"onFail": "error"
		}
	},
	"size-limit": [
		{
			"path": ".svelte-kit/output/client/_app/immutable/**/*.js",
			"limit": "500 kB"
		}
	]
}
