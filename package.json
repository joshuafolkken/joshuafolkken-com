{
	"name": "joshuafolkken-com",
	"private": true,
	"version": "0.127.0",
	"type": "module",
	"packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
	"scripts": {
		"preinstall": "npx only-allow pnpm && pnpm dlx @aikidosec/safe-chain setup-ci",
		"postinstall": "lefthook install",
		"setup:security": "safe-chain setup",
		"dev": "vite dev",
		"dev:cloudflare": "pnpm run build && wrangler dev --remote",
		"build": "vite build",
		"build:preview": "pnpm run build && pnpm run preview",
		"deploy": "pnpm run build && wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"preview:normal": "vite preview",
		"preview:stop": "pnpm exec kill-port 4173 || true",
		"prepare": "pnpm run types && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-fast-check --incremental",
		"check:ci": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "svelte-kit sync && prettier --check . && pnpm run lint:eslint",
		"lint:eslint": "eslint . --cache --cache-strategy content",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"types": "rm -f .svelte-kit/cloudflare/_worker.* && wrangler types",
		"lefthook:install": "lefthook install",
		"lefthook:uninstall": "lefthook uninstall",
		"lefthook:commit": "lefthook run pre-commit",
		"lefthook:push": "lefthook run pre-push",
		"check-commit-message": "tsx scripts/check-commit-message.ts",
		"prevent-main-commit": "tsx scripts/prevent-main-commit.ts",
		"git": "tsx scripts/git-workflow.ts",
		"main:sync": "git checkout main && git pull",
		"main:merge": "git pull origin main",
		"start:pm2": "pm2 restart joshuafolkken-com || pm2 start ecosystem.config.cjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"version:minor": "npm version minor --no-git-tag-version --loglevel=error",
		"update:latest": "pnpm update --latest --save",
		"update:corepack": "corepack use pnpm@latest",
		"cspell:dot": "pnpm cspell . --dot",
		"db:studio": "export LOCAL_DB_PATH=$(find .wrangler/state/v3/d1 -name '*.sqlite' -type f 2>/dev/null | head -1) && drizzle-kit studio"
	},
	"devDependencies": {
		"@aikidosec/safe-chain": "^1.4.4",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@playwright/test": "^1.58.2",
		"@stylistic/eslint-plugin": "^5.9.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^25.3.3",
		"@vitest/browser-playwright": "^4.0.18",
		"better-sqlite3": "^12.6.2",
		"cspell": "^9.7.0",
		"drizzle-kit": "^0.31.9",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-sonarjs": "^4.0.0",
		"eslint-plugin-svelte": "^3.15.0",
		"eslint-plugin-unicorn": "^63.0.0",
		"globals": "^17.4.0",
		"kill-port": "^2.0.1",
		"lefthook": "2.1.2",
		"mdsvex": "^0.12.6",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.53.7",
		"svelte-check": "^4.4.4",
		"svelte-fast-check": "^0.4.5",
		"tailwindcss": "^4.2.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^7.3.1",
		"vite-imagetools": "^10.0.0",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2",
		"wrangler": "^4.70.0"
	},
	"dependencies": {
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.1",
		"sharp": "^0.34.5"
	},
	"pnpm": {
		"updateConfig": {
			"ignoreDependencies": [
				"eslint",
				"@eslint/js"
			]
		},
		"overrides": {
			"esbuild": "^0.25.0",
			"cookie": "^0.7.0",
			"undici": "^7.18.2",
			"minimatch@<3.1.4": "3.1.5",
			"minimatch@>=10.0.0 <10.2.3": "10.2.4",
			"ajv@<6.14.0": "6.14.0"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	}
}
