{
	"name": "joshuafolkken-com",
	"version": "0.295.0",
	"type": "module",
	"private": true,
	"scripts": {
		"preinstall": "pnpm dlx @aikidosec/safe-chain setup-ci",
		"dev": "vite dev",
		"dev:remote": "set -a; [ -f .env ] && . ./.env; set +a; REMOTE_BINDINGS=true vite dev",
		"dev:cloudflare": "pnpm build && wrangler dev --remote",
		"build": "vite build",
		"build:preview": "pnpm build && pnpm preview",
		"deploy": "pnpm build && wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --local",
		"preview:normal": "vite preview",
		"preview:stop": "kill-port 4173 || true",
		"prepare": "pnpm prepare:gen && pnpm prepare:sync && pnpm prepare:lefthook && pnpm prepare:gh-packages",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "pnpm gen:pre && wrangler types",
		"gen:pre": "node -e \"const fs=require('node:fs');const d='.svelte-kit/cloudflare';if(fs.existsSync(d))fs.readdirSync(d).forEach(f=>f.startsWith('_worker.')&&fs.rmSync(d+'/'+f,{force:true}))\"",
		"start:pm2": "pm2 restart joshuafolkken-com || pm2 start ecosystem.config.cjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "export LOCAL_DB_PATH=$(find .wrangler/state/v3/d1 -name '*.sqlite' -type f 2>/dev/null | head -1) && drizzle-kit studio",
		"check:upstream": "tsx scripts/check-upstream-drift.ts",
		"ingest:github-docs": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/ingest-github-documentation.ts",
		"size-limit": "size-limit",
		"yt:audio": "yt-dlp -x --audio-format opus -P .audio --cookies-from-browser chrome --write-info-json --postprocessor-args \"ffmpeg:-c:a libopus -b:a 16k -ac 1\"",
		"yt:article": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/audio-to-article.ts",
		"yt:talk": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/yt-talk.ts",
		"article:frontmatter": "tsx scripts/inject-talk-frontmatter.ts",
		"josh": "josh",
		"prepare:gen": "[ ! -f wrangler.jsonc ] || pnpm gen",
		"prepare:sync": "svelte-kit sync || echo ''",
		"prepare:lefthook": "[ -n \"$CI\" ] || ! command -v lefthook >/dev/null 2>&1 || lefthook install",
		"prepare:gh-packages": "[ -n \"$CI\" ] || ! command -v tsx >/dev/null 2>&1 || tsx node_modules/@joshuafolkken/kit/scripts/fix-gh-packages.ts"
	},
	"dependencies": {
		"@google/genai": "^2.10.0",
		"dompurify": "^3.4.11",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"marked": "^18.0.5",
		"minisearch": "^7.2.0",
		"sharp": "^0.35.3",
		"simple-icons": "^16.25.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@joshuafolkken/app-kit": "0.32.0",
		"@joshuafolkken/kit": "1.7.0",
		"@playwright/test": "^1.61.1",
		"@prgm/sveltekit-progress-bar": "^3.0.2",
		"@size-limit/file": "^12.1.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26.1.0",
		"@vitest/browser-playwright": "^4.1.10",
		"better-sqlite3": "^12.11.1",
		"cspell": "^10.0.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-sonarjs": "^4.1.0",
		"eslint-plugin-svelte": "^3.20.0",
		"eslint-plugin-unicorn": "^71.1.0",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"kill-port": "^2.0.1",
		"lefthook": "2.1.9",
		"mdsvex": "^0.12.7",
		"neverthrow": "^8.2.0",
		"playwright": "^1.61.1",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rollup-plugin-visualizer": "^7.0.1",
		"size-limit": "^12.1.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"svelte-fast-check": "^0.4.5",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.3",
		"vite-imagetools": "^10.0.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.0",
		"wrangler": "4.107.0"
	},
	"packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
	"engines": {
		"node": ">=22.19.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.10.0",
			"onFail": "error"
		}
	},
	"size-limit": [
		{
			"path": ".svelte-kit/output/client/_app/immutable/**/*.js",
			"limit": "500 kB"
		}
	]
}
